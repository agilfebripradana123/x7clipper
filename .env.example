# ============================================
# Web Clipper — Environment Configuration
# ============================================
# Salin file ini menjadi `.env` dan isi nilainya.

# --- 9router (AI Gateway) ---
NINEROUTER_BASE_URL=https://api.9router.com/v1
NINEROUTER_API_KEY=your-9router-api-key
NINEROUTER_MODEL=your-model-id

# --- Redis (Queue Broker) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Database ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=web_clipper
DB_USERNAME=root
DB_PASSWORD=

# --- External Binaries ---
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# --- Storage Paths ---
STORAGE_TMP=./storage/tmp
STORAGE_TRANSCRIPTS=./storage/transcripts
STORAGE_RAW_CLIPS=./storage/raw-clips
STORAGE_EXPORTS=./storage/exports

# --- Server ---
API_PORT=8000
WORKER_CONCURRENCY=2
